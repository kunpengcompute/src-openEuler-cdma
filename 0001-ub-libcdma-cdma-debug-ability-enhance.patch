@@ -424,13 +425,13 @@ dma_jfc_t *cdma_u_create_jfc(struct dma_context *ctx, dma_jfc_cfg_t *cfg)
 
 	ret = cdma_u_alloc_jfc_buf(cdma_ctx, cfg, cdma_jfc);
 	if (ret) {
-		CDMA_LOG_ERR("alloc jfc buf failed.\n");
