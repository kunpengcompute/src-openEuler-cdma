+	cfg = &cdma_queue->cdma_tp->cfg;
+
 	ret = cdma_u_post_jfs_wr(cdma_queue->cdma_jfs, &wr, &bad_wr);
 	if (ret) {
-		CDMA_LOG_ERR("post jfs for cas failed, ret = %d.\n", ret);
